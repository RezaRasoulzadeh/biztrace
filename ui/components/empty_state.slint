// ui/components/empty_state.slint

import { BizTraceIcon } from "biztrace_icon.slint";
import { BizTraceTheme } from "theme.slint";
import { RtlButton } from "rtl_button.slint";
import { RtlCard } from "rtl_card.slint";
import { RtlText } from "rtl_text.slint";

export component EmptyState inherits RtlCard {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <string> action-text;
    in property <image> action-icon;
    callback action;
    height: 250px;

    VerticalLayout {
        padding: 28px;
        spacing: 10px;
        alignment: center;

        Rectangle {
            height: 42px;
            background: transparent;

            BizTraceIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 34px;
                height: 34px;
                source: root.icon;
                tint: BizTraceTheme.brand-soft;
            }
        }

        RtlText {
            height: 28px;
            text: root.title;
            font-size: 17px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        RtlText {
            height: 44px;
            text: root.description;
            color: BizTraceTheme.text-muted;
            horizontal-alignment: center;
        }

        if !root.action-text.is-empty : Rectangle {
            height: 38px;
            background: transparent;

            RtlButton {
                x: (parent.width - self.width) / 2;
                width: 180px;
                height: parent.height;
                text: root.action-text;
                icon: root.action-icon;
                clicked => { root.action(); }
            }
        }
    }
}
