// ui/components/rtl_button.slint

import { NexoraTheme } from "theme.slint";
import { NexoraIcon } from "nexora_icon.slint";
import { RtlText } from "rtl_text.slint";

export component RtlButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: true;
    callback clicked;
    min-height: 36px;
    background: root.primary ? touch.pressed ? NexoraTheme.brand-pressed : touch.has-hover ? NexoraTheme.brand-hover : NexoraTheme.brand : touch.has-hover ? NexoraTheme.control-hover : NexoraTheme.control;
    border-color: root.primary ? transparent : NexoraTheme.border;
    border-width: root.primary ? 0px : 1px;
    border-radius: 7px;
    accessible-role: button;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        RtlText {
            text: root.text;
            color: white;
            font-weight: 600;
            wrap: no-wrap;
            overflow: elide;
        }

        if root.icon.width > 0 : Rectangle {
            width: 19px;
            background: transparent;

            NexoraIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 17px;
                height: 17px;
                source: root.icon;
                tint: white;
            }
        }
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}
