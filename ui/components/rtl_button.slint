// ui/components/rtl_button.slint

import { NexoraTheme } from "theme.slint";
import { NexoraIcon } from "nexora_icon.slint";
import { RtlText } from "rtl_text.slint";

export component RtlButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked;
    min-height: 36px;
    background: touch.pressed ? NexoraTheme.brand-pressed : touch.has-hover ? NexoraTheme.brand-hover : NexoraTheme.brand;
    border-radius: 7px;
    accessible-role: button;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;

        RtlText {
            text: root.text;
            color: white;
            font-weight: 600;
            wrap: no-wrap;
            overflow: elide;
        }

        if root.icon.width > 0 : NexoraIcon {
            width: 17px;
            height: 17px;
            source: root.icon;
            tint: white;
        }
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}
