// ui/components/tip_row.slint

import { BizTraceIcon } from "biztrace_icon.slint";
import { BizTraceTheme } from "theme.slint";
import { RtlText } from "rtl_text.slint";

export component TipRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    height: 52px;
    background: transparent;

    Rectangle {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: 34px;
        height: 34px;
        background: #2489023e;
        border-radius: 17px;

        BizTraceIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 17px;
            height: 17px;
            source: root.icon;
            tint: BizTraceTheme.brand-soft;
        }
    }

    RtlText {
        x: 0;
        width: parent.width - 46px;
        height: parent.height;
        text: root.text;
        color: BizTraceTheme.text-muted;
        font-size: 12px;
    }
}
