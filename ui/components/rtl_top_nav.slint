// ui/components/rtl_top_nav.slint

import { BizTraceTheme } from "theme.slint";
import { BizTraceIcon } from "biztrace_icon.slint";
import { RtlText } from "rtl_text.slint";

export component RtlTopNav inherits Rectangle {
    in property <string> user-name;
    callback profile-clicked;
    height: 62px;
    background: BizTraceTheme.surface;

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: BizTraceTheme.border;
    }

    profile := Rectangle {
        x: 18px;
        y: (parent.height - self.height) / 2;
        width: 38px;
        height: 38px;
        background: profile-touch.has-hover ? BizTraceTheme.brand-hover : BizTraceTheme.brand;
        border-radius: 19px;

        BizTraceIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 19px;
            height: 19px;
            source: @image-url("../../assets/icons/user-round.svg");
            tint: white;
        }

        profile-touch := TouchArea { clicked => { root.profile-clicked(); } }
    }

    if root.width >= 620px : RtlText {
        x: profile.x + profile.width + 14px;
        y: 0;
        width: 132px;
        height: parent.height;
        text: root.user-name;
        horizontal-alignment: left;
        wrap: no-wrap;
        overflow: elide;
    }

    brand := RtlText {
        x: parent.width - self.width - 20px;
        y: 0;
        width: 146px;
        height: parent.height;
        text: "BIZTRACE";
        color: BizTraceTheme.brand;
        font-size: 25px;
        font-weight: 700;
        horizontal-alignment: right;
        wrap: no-wrap;
    }
}
