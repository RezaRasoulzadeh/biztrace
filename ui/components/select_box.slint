// ui/components/select_box.slint

import { BizTraceIcon } from "biztrace_icon.slint";
import { BizTraceTheme } from "theme.slint";

export component SelectBox inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 20px;
    height: 20px;
    background: root.checked ? BizTraceTheme.brand : touch.has-hover ? BizTraceTheme.control-hover : BizTraceTheme.control;
    border-color: root.checked ? BizTraceTheme.brand : BizTraceTheme.border;
    border-width: 1px;
    border-radius: 5px;
    animate background { duration: 100ms; }
    if root.checked : BizTraceIcon { x: 3px; y: 3px; width: 14px; height: 14px; source: @image-url("../../assets/icons/check.svg"); tint: white; }
    touch := TouchArea { clicked => { root.toggled(!root.checked); } }
}
