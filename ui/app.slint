// ui/app.slint

import { DateService, FormattedInput, BizTraceTheme, RtlSidebar, RtlToast, RtlTopNav, SearchOption } from "components/mod.slint";
export { DateService } from "components/mod.slint";
import {
    CatalogPage,
    CatalogItemData,
    CustomerItemData,
    CustomersPage,
    DashboardPage,
    FundsPage,
    FundAccountData,
    FundTransactionData,
    FundCheckData,
    InventoryPage,
    InvoicesPage,
    MovementItemData,
    SettingsPage,
    StockItemData,
    WarehouseItemData,
    UsersPage
} from "pages/mod.slint";

export component AppWindow inherits Window {
    title: "BizTrace";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 420px;
    min-height: 480px;
    background: BizTraceTheme.canvas;
    default-font-family: BizTraceTheme.font-family;

    in-out property <int> navigation-index;
    in-out property <bool> navigation-expanded: true;
    in property <int> invoice-count;
    in property <int> customer-count;
    in property <int> catalog-count;
    in property <int> warehouse-count;
    in property <int> fund-account-count;
    in property <int> transaction-count;
    in property <int> user-count;
    in-out property <string> status-message;
    in property <[CatalogItemData]> catalog-items;
    in-out property <string> catalog-search-text;
    in-out property <int> catalog-sort-index;
    in property <int> catalog-selected-count;
    in-out property <bool> catalog-editor-open;
    in-out property <string> catalog-editor-error;
    in-out property <bool> notification-open;
    in property <[CustomerItemData]> customer-items;
    in-out property <string> customer-search-text;
    in-out property <int> customer-sort-index;
    in-out property <bool> customer-editor-open;
    in-out property <string> customer-editor-error;
    in-out property <bool> customer-balance-editor-open;
    in-out property <string> customer-balance-editor-error;
    in property <int> customer-selected-count;
    callback customer-search(string);
    callback customer-sort-changed(int);
    callback customer-save(string, string, string, string, string, int);
    callback customer-format-balance(string, int) -> FormattedInput;
    pure callback customer-balance-preview(string, string, int) -> string;
    callback customer-adjust-balance(string, int, string, string);
    callback customer-remove(string);
    callback customer-settle-balance(string);
    callback customer-download-template;
    callback customer-import-excel;
    callback customer-selection-changed(string, bool);
    callback customer-select-all;
    callback customer-clear-selection;
    callback customer-export-all;
    callback customer-export-selected;
    in property <[FundAccountData]> fund-accounts;
    in property <[FundTransactionData]> fund-transactions;
    in property <[FundCheckData]> fund-checks;
    in property <[string]> fund-account-names;
    in-out property <string> fund-search-text;
    in-out property <bool> fund-account-editor-open;
    in-out property <bool> fund-transaction-editor-open;
    in-out property <bool> fund-check-editor-open;
    in-out property <string> fund-editor-error;
    in property <int> fund-selected-count;
    callback fund-save-account(string,string,string,int,string);
    callback fund-remove-account(string);
    callback fund-save-transaction(string,int,int,int,string,string,string,string);
    callback fund-remove-transaction(string);
    callback fund-save-check(string,int,int,int,string,string,string,string,string,string);
    callback fund-remove-check(string);
    callback fund-selection-changed(int,string,bool);
    callback fund-select-all(int);
    callback fund-clear-selection(int);
    callback fund-remove-selected(int);
    callback fund-check-status(string,int);
    callback fund-search(string);
    callback fund-to-gregorian(int,int,int) -> string;
    pure callback fund-calendar-day(int,int,int) -> int;
    callback fund-download-template(int);
    callback fund-import-excel(int);
    callback fund-export-data(int);
    callback catalog-search(string);
    callback catalog-save(string, string, string, int, int, string);
    callback catalog-format-price(string, int) -> FormattedInput;
    callback catalog-remove(string);
    callback catalog-download-template;
    callback catalog-import-excel;
    callback catalog-sort-changed(int);
    callback catalog-selection-changed(string, bool);
    callback catalog-select-all;
    callback catalog-clear-selection;
    callback catalog-export-all;
    callback catalog-export-selected;
    callback catalog-remove-selected;
    in property <[StockItemData]> inventory-items;
    in property <[MovementItemData]> inventory-movements;
    in property <[WarehouseItemData]> inventory-warehouse-items;
    in property <[string]> inventory-warehouses;
    in property <[string]> inventory-warehouse-alternative-names;
    in property <[string]> inventory-warehouse-alternative-ids;
    in property <[SearchOption]> inventory-product-options;
    in-out property <string> inventory-search-text;
    in-out property <int> inventory-sort-index;
    in property <int> inventory-selected-count;
    in-out property <bool> warehouse-editor-open;
    in-out property <bool> movement-editor-open;
    in-out property <bool> stock-editor-open;
    in-out property <bool> warehouse-removal-open;
    in-out property <string> inventory-editor-error;
    callback inventory-search(string);
    callback inventory-product-search(string);
    callback save-warehouse(string, string, string);
    callback record-inventory-movement(int, string, string, int, string, string, string);
    callback set-stock-level(string, int, string, string, string);
    callback remove-stock-layer(string);
    callback inventory-download-template;
    callback inventory-import-excel;
    callback remove-warehouse(string);
    callback prepare-warehouse-removal(string);
    callback force-remove-warehouse(string, string);
    callback inventory-sort-changed(int);
    callback inventory-selection-changed(string, bool);
    callback inventory-select-all;
    callback inventory-clear-selection;
    callback inventory-export-all;
    callback inventory-export-selected;
    callback inventory-remove-selected;
    property <bool> compact-navigation: !root.navigation-expanded || root.width < 620px;
    property <length> workspace-width: root.width - sidebar.width;
    property <bool> narrow-content: root.workspace-width < 640px;

    FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        focus-on-click: true;
        focus-on-tab-navigation: false;
    }

    if root.navigation-index == 0 : DashboardPage {
        x: 0;
        y: top-nav.height;
        width: root.workspace-width;
        height: parent.height - top-nav.height;
        narrow: root.narrow-content;
        invoice-count: root.invoice-count;
        customer-count: root.customer-count;
        catalog-count: root.catalog-count;
        transaction-count: root.transaction-count;
    }

    if root.navigation-index == 1 : InvoicesPage {
        x: 0;
        y: top-nav.height;
        width: root.workspace-width;
        height: parent.height - top-nav.height;
        narrow: root.narrow-content;
        item-count: root.invoice-count;
        create => {
            root.status-message = "فرایند صدور فاکتور در مرحله بعد اضافه می‌شود";
            toast.open = true;
        }
    }

    if root.navigation-index == 2 : CatalogPage {
        x: 0;
        y: top-nav.height;
        width: root.workspace-width;
        height: parent.height - top-nav.height;
        narrow: root.narrow-content;
        items: root.catalog-items;
        search-text <=> root.catalog-search-text;
        sort-index <=> root.catalog-sort-index;
        selected-count: root.catalog-selected-count;
        editor-open <=> root.catalog-editor-open;
        editor-error: root.catalog-editor-error;
        search(value) => { root.catalog-search(value); }
        save(id, name, sku, kind, unit, price) => { root.catalog-save(id, name, sku, kind, unit, price); }
        format-price(value, cursor) => { return root.catalog-format-price(value, cursor); }
        remove(id) => { root.catalog-remove(id); }
        download-template => { root.catalog-download-template(); }
        import-excel => { root.catalog-import-excel(); }
        sort-changed(index) => { root.catalog-sort-changed(index); }
        selection-changed(id, selected) => { root.catalog-selection-changed(id, selected); }
        select-all => { root.catalog-select-all(); }
        clear-selection => { root.catalog-clear-selection(); }
        export-all => { root.catalog-export-all(); }
        export-selected => { root.catalog-export-selected(); }
        remove-selected => { root.catalog-remove-selected(); }
    }

    if root.navigation-index == 3 : CustomersPage {
        x: 0;
        y: top-nav.height;
        width: root.workspace-width;
        height: parent.height - top-nav.height;
        narrow: root.narrow-content;
        items: root.customer-items;
        search-text <=> root.customer-search-text;
        sort-index <=> root.customer-sort-index;
        editor-open <=> root.customer-editor-open;
        editor-error: root.customer-editor-error;
        balance-editor-open <=> root.customer-balance-editor-open;
        balance-editor-error: root.customer-balance-editor-error;
        selected-count: root.customer-selected-count;
        search(value) => { root.customer-search(value); }
        sort-changed(index) => { root.customer-sort-changed(index); }
        save(id, name, phone, email, address, kind) => { root.customer-save(id, name, phone, email, address, kind); }
        format-balance(value, cursor) => { return root.customer-format-balance(value, cursor); }
        balance-preview(id, amount, direction) => { return root.customer-balance-preview(id, amount, direction); }
        adjust-balance(id, direction, amount, note) => { root.customer-adjust-balance(id, direction, amount, note); }
        remove(id) => { root.customer-remove(id); }
        settle-balance(id) => { root.customer-settle-balance(id); }
        download-template => { root.customer-download-template(); }
        import-excel => { root.customer-import-excel(); }
        selection-changed(id, selected) => { root.customer-selection-changed(id, selected); }
        select-all => { root.customer-select-all(); }
        clear-selection => { root.customer-clear-selection(); }
        export-all => { root.customer-export-all(); }
        export-selected => { root.customer-export-selected(); }
    }

    if root.navigation-index == 4 : InventoryPage {
        x: 0;
        y: top-nav.height;
        width: root.workspace-width;
        height: parent.height - top-nav.height;
        narrow: root.narrow-content;
        items: root.inventory-items;
        movements: root.inventory-movements;
        warehouse-items: root.inventory-warehouse-items;
        warehouses: root.inventory-warehouses;
        warehouse-alternative-names: root.inventory-warehouse-alternative-names;
        warehouse-alternative-ids: root.inventory-warehouse-alternative-ids;
        product-options: root.inventory-product-options;
        search-text <=> root.inventory-search-text;
        sort-index <=> root.inventory-sort-index;
        selected-count: root.inventory-selected-count;
        warehouse-editor-open <=> root.warehouse-editor-open;
        movement-editor-open <=> root.movement-editor-open;
        stock-editor-open <=> root.stock-editor-open;
        warehouse-removal-open <=> root.warehouse-removal-open;
        editor-error: root.inventory-editor-error;
        format-price(value, cursor) => { return root.catalog-format-price(value, cursor); }
        search(value) => { root.inventory-search(value); }
        search-product(value) => { root.inventory-product-search(value); }
        save-warehouse(id, name, address) => { root.save-warehouse(id, name, address); }
        record-movement(warehouse, product, layer, direction, quantity, cost, reference) => {
            root.record-inventory-movement(warehouse, product, layer, direction, quantity, cost, reference);
        }
        set-stock(layer, warehouse, quantity, cost, reference) => { root.set-stock-level(layer, warehouse, quantity, cost, reference); }
        remove-stock(layer) => { root.remove-stock-layer(layer); }
        download-template => { root.inventory-download-template(); }
        import-excel => { root.inventory-import-excel(); }
        remove-warehouse(id) => { root.remove-warehouse(id); }
        prepare-warehouse-removal(id) => { root.prepare-warehouse-removal(id); }
        force-remove-warehouse(id, alternate) => { root.force-remove-warehouse(id, alternate); }
        sort-changed(index) => { root.inventory-sort-changed(index); }
        selection-changed(id, selected) => { root.inventory-selection-changed(id, selected); }
        select-all => { root.inventory-select-all(); }
        clear-selection => { root.inventory-clear-selection(); }
        export-all => { root.inventory-export-all(); }
        export-selected => { root.inventory-export-selected(); }
        remove-selected => { root.inventory-remove-selected(); }
    }

    if root.navigation-index == 5 : FundsPage {
        x: 0;
        y: top-nav.height;
        width: root.workspace-width;
        height: parent.height - top-nav.height;
        narrow: root.narrow-content;
        accounts:root.fund-accounts;transactions:root.fund-transactions;checks:root.fund-checks;account-names:root.fund-account-names;search-text<=>root.fund-search-text;account-editor-open<=>root.fund-account-editor-open;transaction-editor-open<=>root.fund-transaction-editor-open;check-editor-open<=>root.fund-check-editor-open;editor-error:root.fund-editor-error;selected-count:root.fund-selected-count;
        format-amount(v,c)=>{return root.customer-format-balance(v,c);} to-gregorian(y,m,d)=>{return root.fund-to-gregorian(y,m,d);} calendar-day(y,m,c)=>{return root.fund-calendar-day(y,m,c);} download-template(tab)=>{root.fund-download-template(tab);} import-excel(tab)=>{root.fund-import-excel(tab);} export-data(tab)=>{root.fund-export-data(tab);} search(v)=>{root.fund-search(v);} save-account(id,name,number,kind,balance)=>{root.fund-save-account(id,name,number,kind,balance);} remove-account(id)=>{root.fund-remove-account(id);} save-transaction(id,kind,account,target,amount,date,reference,description)=>{root.fund-save-transaction(id,kind,account,target,amount,date,reference,description);} remove-transaction(id)=>{root.fund-remove-transaction(id);} remove-check(id)=>{root.fund-remove-check(id);} selection-changed(tab,id,value)=>{root.fund-selection-changed(tab,id,value);} select-all(tab)=>{root.fund-select-all(tab);} clear-selection(tab)=>{root.fund-clear-selection(tab);} remove-selected(tab)=>{root.fund-remove-selected(tab);} save-check(id,type,direction,account,party,number,bank,amount,due,note)=>{root.fund-save-check(id,type,direction,account,party,number,bank,amount,due,note);} check-status(id,status)=>{root.fund-check-status(id,status);}
    }

    if root.navigation-index == 6 : UsersPage {
        x: 0;
        y: top-nav.height;
        width: root.workspace-width;
        height: parent.height - top-nav.height;
        narrow: root.narrow-content;
        item-count: root.user-count;
        create => {
            root.status-message = "مدیریت کاربران همراه راه‌اندازی مدیر اصلی تکمیل می‌شود";
            toast.open = true;
        }
    }

    if root.navigation-index == 7 : SettingsPage {
        x: 0;
        y: top-nav.height;
        width: root.workspace-width;
        height: parent.height - top-nav.height;
        narrow: root.narrow-content;
    }

    sidebar := RtlSidebar {
        x: parent.width - self.width;
        y: top-nav.height;
        height: parent.height - top-nav.height;
        compact: root.compact-navigation;
        current-index <=> root.navigation-index;
        toggled => {
            root.navigation-expanded = !root.navigation-expanded;
        }
        items: [
            { label: "داشبورد", icon: @image-url("../assets/icons/layout-dashboard.svg") },
            { label: "فاکتورها", icon: @image-url("../assets/icons/receipt-text.svg") },
            { label: "کالاها و خدمات", icon: @image-url("../assets/icons/package.svg") },
            { label: "مشتریان", icon: @image-url("../assets/icons/users.svg") },
            { label: "موجودی و انبار", icon: @image-url("../assets/icons/warehouse.svg") },
            { label: "وجوه و حساب‌ها", icon: @image-url("../assets/icons/wallet-cards.svg") },
            { label: "کاربران", icon: @image-url("../assets/icons/user-round-cog.svg") },
            { label: "تنظیمات", icon: @image-url("../assets/icons/settings.svg") }
        ];
    }

    top-nav := RtlTopNav {
        x: 0;
        y: 0;
        width: parent.width;
        user-name: "مدیر سیستم";
    }

    toast := RtlToast {
        x: max(16px, root.workspace-width - self.width - 24px);
        width: min(420px, root.workspace-width - 32px);
        message: root.status-message;
        open <=> root.notification-open;
    }
}
