import { ConfirmDialog, DateService, EmptyState, FormattedInput, BizTraceIcon, BizTraceTheme, RtlButton, RtlHeading, RtlLineEdit, RtlTableHeaderCell, RtlTabs, RtlText, SelectBox, TipRow } from "../components/mod.slint";
import { ScrollView } from "std-widgets.slint";
import { FundAccountData, FundAccountRow, FundTransactionData, FundTransactionRow, FundCheckData, FundCheckRow } from "fund_rows.slint";
import { FundAccountEditor, FundTransactionEditor, FundCheckEditor } from "fund_editors.slint";

export component FundsPage inherits Rectangle {
    in property <bool> narrow;
    in property <[FundAccountData]> accounts;
    in property <[FundTransactionData]> transactions;
    in property <[FundCheckData]> checks;
    in property <[string]> account-names;
    in-out property <string> search-text;
    in-out property <bool> account-editor-open;
    in-out property <bool> transaction-editor-open;
    in-out property <bool> check-editor-open;
    in property <string> editor-error;
    in property <int> selected-count;
    callback search(string);
    callback format-amount(string, int) -> FormattedInput;
    callback to-gregorian(int, int, int) -> string;
    pure callback calendar-day(int, int, int) -> int;
    callback download-template(int);
    callback import-excel(int);
    callback export-data(int);
    callback save-account(string, string, string, int, string);
    callback remove-account(string);
    callback save-transaction(string, int, int, int, string, string, string, string);
    callback remove-transaction(string);
    callback save-check(string, int, int, int, string, string, string, string, string, string);
    callback remove-check(string);
    callback selection-changed(int, string, bool);
    callback select-all(int);
    callback clear-selection(int);
    callback remove-selected(int);
    callback check-status(string, int);
    background: transparent;
    property <int> current-tab;
    property <int> check-filter;
    property <bool> all-visible-selected;
    property <bool> show-tips: root.width >= 1050px;
    property <length> tips-width: 310px;
    property <length> content-width: root.width - (root.show-tips ? root.tips-width : 0px);
    property <bool> compact-content: root.narrow || root.content-width < 700px;

    ScrollView {
        x: root.show-tips ? root.tips-width : 0px;
        width: root.content-width;
        height: parent.height;
        VerticalLayout {
            padding: root.compact-content ? 14px : 28px;
            spacing: 14px;
            alignment: start;
            RtlHeading { text: "وجوه و حساب‌ها"; }
            RtlText { text: "مدیریت حساب‌ها، گردش‌های مالی و تعهدات زمان‌بندی‌شده"; color: BizTraceTheme.text-muted; }
            RtlTabs { tabs: ["حساب‌ها", "تراکنش‌ها", "تعهدات و سررسیدها"]; current-index <=> root.current-tab; }

            HorizontalLayout {
                height: 40px; spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                RtlButton { width: 125px; text: "خروجی همه"; icon: @image-url("../../assets/icons/download.svg"); primary: false; clicked => { root.export-data(root.current-tab); } }
                RtlButton { width: 135px; text: "فایل نمونه"; icon: @image-url("../../assets/icons/download.svg"); primary: false; clicked => { root.download-template(root.current-tab); } }
                RtlButton { width: 135px; text: "ورود اکسل"; icon: @image-url("../../assets/icons/file-spreadsheet.svg"); primary: false; clicked => { root.import-excel(root.current-tab); } }
                RtlButton { width: 155px; text: root.current-tab == 0 ? "حساب جدید" : root.current-tab == 1 ? "تراکنش جدید" : "سررسید جدید"; icon: root.current-tab == 0 ? @image-url("../../assets/icons/wallet-cards.svg") : root.current-tab == 1 ? @image-url("../../assets/icons/receipt-text.svg") : @image-url("../../assets/icons/notebook-pen.svg"); clicked => { root.open-new(); } }
            }

            if root.current-tab > 0 : HorizontalLayout { height: 40px; spacing: 8px; RtlText { width: 72px; text: (root.current-tab == 1 ? root.transactions.length : root.checks.length) + " مورد"; color: BizTraceTheme.text-muted; font-size: 12px; } RtlLineEdit { horizontal-stretch: 1; text <=> root.search-text; placeholder-text: root.current-tab == 1 ? "جستجو با حساب، شرح یا شناسه" : "جستجو با طرف حساب، شماره سند یا بانک"; edited(value) => { root.all-visible-selected = false; root.search(value); } } }
            if root.current-tab == 2 : RtlTabs { tabs: ["همه سررسیدها", "دریافتی", "پرداختی"]; current-index <=> root.check-filter; }

            if root.selected-count > 0 : HorizontalLayout { height: 38px; spacing: 8px; RtlText { horizontal-stretch: 1; text: root.selected-count + " انتخاب‌شده"; color: BizTraceTheme.text-muted; } RtlButton { width: 150px; text: "خروجی انتخاب"; icon: @image-url("../../assets/icons/download.svg"); primary: false; clicked => { root.export-data(root.current-tab + 10); } } RtlButton { width: 140px; text: "حذف انتخاب"; icon: @image-url("../../assets/icons/trash-2.svg"); clicked => { bulk-confirm.open = true; } } }

            if root.current-tab == 0 && root.accounts.length > 0 : Rectangle { height: 30px; HorizontalLayout { width: parent.width - 72px; padding-left: 14px; padding-right: 14px; RtlTableHeaderCell { width: 78px; text: "عملیات"; } RtlTableHeaderCell { width: 150px; text: "مانده"; } RtlTableHeaderCell { horizontal-stretch: 1; text: "حساب"; } } SelectBox { x: parent.width - self.width - 8px; y: 3px; checked: root.all-visible-selected; toggled(value) => { root.toggle-all(value); } } }
            if root.current-tab == 1 && root.transactions.length > 0 : Rectangle { height: 30px; HorizontalLayout { width: parent.width - 72px; padding-left: 14px; padding-right: 14px; RtlTableHeaderCell { width: 78px; text: "عملیات"; } RtlTableHeaderCell { width: 120px; text: "تاریخ"; } RtlTableHeaderCell { width: 150px; text: "مبلغ"; } RtlTableHeaderCell { horizontal-stretch: 1; text: "شرح تراکنش"; } } SelectBox { x: parent.width - self.width - 8px; y: 3px; checked: root.all-visible-selected; toggled(value) => { root.toggle-all(value); } } }
            if root.current-tab == 2 && root.checks.length > 0 : Rectangle { height: 30px; HorizontalLayout { width: parent.width - 72px; padding-left: 14px; padding-right: 14px; RtlTableHeaderCell { width: 180px; text: "عملیات"; } RtlTableHeaderCell { width: 105px; text: "سررسید"; } RtlTableHeaderCell { width: 145px; text: "مبلغ"; } RtlTableHeaderCell { horizontal-stretch: 1; text: "نوع سند و طرف حساب"; } } SelectBox { x: parent.width - self.width - 8px; y: 3px; checked: root.all-visible-selected; toggled(value) => { root.toggle-all(value); } } }

            if root.current-tab == 0 && root.accounts.length == 0 : EmptyState { icon: @image-url("../../assets/icons/wallet-cards.svg"); title: "حساب مالی وجود ندارد"; description: "صندوق اصلی به‌صورت خودکار ساخته می‌شود."; action-text: "افزودن حساب"; action => { root.open-new(); } }
            if root.current-tab == 0 : VerticalLayout { spacing: 8px; for item in root.accounts : FundAccountRow { item: item; edit => { account-editor.item-id=item.id; account-editor.item-name=item.name; account-editor.account-number=item.account-number; account-editor.opening-balance=item.opening-value; account-editor.kind-index=item.kind-label=="صندوق نقدی"?0:item.kind-label=="حساب بانکی"?1:item.kind-label=="کارت"?2:3; root.account-editor-open=true; } remove => { root.remove-account(item.id); } selection-changed(value) => { root.selection(item.id, value); } } }
            if root.current-tab == 1 && root.transactions.length == 0 : EmptyState { icon: @image-url("../../assets/icons/receipt-text.svg"); title: "تراکنشی ثبت نشده"; description: "درآمد، هزینه یا انتقال بین حساب‌ها را ثبت کنید."; action-text: "ثبت تراکنش"; action => { root.open-new(); } }
            if root.current-tab == 1 : VerticalLayout { spacing: 8px; for item in root.transactions : FundTransactionRow { item:item; edit=>{transaction-editor.item-id=item.id;transaction-editor.kind-index=item.kind-index;transaction-editor.account-index=item.account-index;transaction-editor.target-index=item.target-index;transaction-editor.amount=item.amount-value;transaction-editor.occurred-on=item.occurred-on;transaction-editor.reference=item.reference;transaction-editor.description=item.description;transaction-editor.fix-target();root.transaction-editor-open=true;} remove=>{root.remove-transaction(item.id);} selection-changed(value)=>{root.selection(item.id,value);} } }
            if root.current-tab == 2 && root.checks.length == 0 : EmptyState { icon: @image-url("../../assets/icons/notebook-pen.svg"); title: "سررسیدی ثبت نشده"; description: "چک‌ها، اقساط و دریافت‌ها یا پرداخت‌های آینده را اینجا پیگیری کنید."; action-text: "ثبت سررسید"; action => { root.open-new(); } }
            if root.current-tab == 2 : VerticalLayout { spacing: 8px; for item in root.checks : FundCheckRow { visible: root.check-filter == 0 || root.check-filter == item.direction-index + 1; item:item; edit=>{check-editor.item-id=item.id;check-editor.type-index=item.type-index;check-editor.direction-index=item.direction-index;check-editor.account-index=item.account-index;check-editor.party-name=item.party-name;check-editor.check-number=item.check-number;check-editor.bank-name=item.bank-name;check-editor.amount=item.amount-value;check-editor.due-on=item.due-on;check-editor.note=item.note;root.check-editor-open=true;} remove=>{root.remove-check(item.id);} status(value)=>{root.check-status(item.id,value);} selection-changed(value)=>{root.selection(item.id,value);} } }
        }
    }

    Rectangle { x: root.show-tips ? 0px : -root.tips-width; width: root.tips-width; height: parent.height; background: BizTraceTheme.surface; visible: root.show-tips; Rectangle { x: parent.width - 3px; width: 3px; height: parent.height; background: BizTraceTheme.brand; } VerticalLayout { padding: 22px; padding-top: 28px; spacing: 7px; HorizontalLayout { height: 46px; Rectangle { horizontal-stretch: 1; } RtlHeading { text: root.current-tab==0?"ورود گروهی حساب‌ها":root.current-tab==1?"ورود گروهی تراکنش‌ها":"ورود گروهی سررسیدها"; font-size: 18px; } Rectangle { width: 42px; height: 42px; background: BizTraceTheme.brand; border-radius: 21px; BizTraceIcon { x:10px;y:10px;width:21px;height:21px;source:@image-url("../../assets/icons/file-spreadsheet.svg");tint:white;} } } RtlText { height:42px;text:"فایل هر تب، ستون‌های متناسب با همان بخش را دارد.";color:BizTraceTheme.text-muted;font-size:12px;} TipRow{icon:@image-url("../../assets/icons/download.svg");text:"ابتدا فایل نمونه همان تب را دریافت کنید.";} TipRow{icon:@image-url("../../assets/icons/calendar-days.svg");text:"تاریخ‌ها در فایل اکسل به‌صورت شمسی هستند.";} TipRow{icon:@image-url("../../assets/icons/badge-dollar-sign.svg");text:"دریافتی‌ها سبز و پرداختی‌ها قرمز نمایش داده می‌شوند.";} } }

    function selection(id:string,value:bool){if !value{root.all-visible-selected=false;}root.selection-changed(root.current-tab,id,value);}
    function toggle-all(value:bool){root.all-visible-selected=value;if value{root.select-all(root.current-tab);}else{root.clear-selection(root.current-tab);}}
    function open-new(){if root.current-tab==0{account-editor.item-id="";account-editor.item-name="";account-editor.account-number="";account-editor.opening-balance="0";account-editor.kind-index=1;root.account-editor-open=true;}else if root.current-tab==1{transaction-editor.item-id="";transaction-editor.kind-index=0;transaction-editor.account-index=0;transaction-editor.target-index=root.account-names.length>1?1:0;transaction-editor.amount="";transaction-editor.occurred-on=DateService.today-date();transaction-editor.reference="";transaction-editor.description="";root.transaction-editor-open=true;}else{check-editor.item-id="";check-editor.type-index=0;check-editor.direction-index=0;check-editor.account-index=0;check-editor.party-name="";check-editor.check-number="";check-editor.bank-name="";check-editor.amount="";check-editor.due-on=DateService.today-date();check-editor.note="";root.check-editor-open=true;}}

    account-editor:=FundAccountEditor{width:parent.width;height:parent.height;open<=>root.account-editor-open;error-message:root.editor-error;format(v,c)=>{return root.format-amount(v,c);}save(id,name,number,kind,balance)=>{root.save-account(id,name,number,kind,balance);}}
    transaction-editor:=FundTransactionEditor{width:parent.width;height:parent.height;open<=>root.transaction-editor-open;accounts:root.account-names;error-message:root.editor-error;format(v,c)=>{return root.format-amount(v,c);}to-gregorian(y,m,d)=>{return root.to-gregorian(y,m,d);}calendar-day(y,m,c)=>{return root.calendar-day(y,m,c);}save(id,kind,account,target,amount,date,reference,description)=>{root.save-transaction(id,kind,account,target,amount,date,reference,description);}}
    check-editor:=FundCheckEditor{width:parent.width;height:parent.height;open<=>root.check-editor-open;accounts:root.account-names;error-message:root.editor-error;format(v,c)=>{return root.format-amount(v,c);}to-gregorian(y,m,d)=>{return root.to-gregorian(y,m,d);}calendar-day(y,m,c)=>{return root.calendar-day(y,m,c);}save(id,type,direction,account,party,number,bank,amount,due,note)=>{root.save-check(id,type,direction,account,party,number,bank,amount,due,note);}}
    bulk-confirm:=ConfirmDialog{width:parent.width;height:parent.height;title:"حذف موارد انتخاب‌شده";message:root.selected-count+" مورد انتخاب‌شده حذف شوند؟ موارد وابسته نادیده گرفته می‌شوند.";confirm-text:"حذف انتخاب";confirmed=>{root.remove-selected(root.current-tab);}}
}
