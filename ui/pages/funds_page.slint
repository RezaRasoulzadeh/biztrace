// ui/pages/funds_page.slint

import { EmptyState, PageHeader } from "../components/mod.slint";
import { ScrollView } from "std-widgets.slint";

export component FundsPage inherits Rectangle {
    in property <bool> narrow;
    in property <int> account-count;
    callback create;
    background: transparent;

    ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            padding: root.narrow ? 14px : 28px;
            spacing: 18px;
            PageHeader { title: "وجوه و حساب‌ها"; description: "درآمدها، هزینه‌ها و انتقال بین حساب‌ها"; action-text: "حساب جدید"; action-icon: @image-url("../../assets/icons/wallet-cards.svg"); narrow: root.narrow; action => { root.create(); } }
            EmptyState { icon: @image-url("../../assets/icons/wallet-cards.svg"); title: "حساب مالی وجود ندارد"; description: "صندوق، حساب بانکی یا حساب نقدی خود را تعریف کنید."; action-text: "افزودن حساب"; action-icon: @image-url("../../assets/icons/wallet-cards.svg"); action => { root.create(); } }
        }
    }
}
