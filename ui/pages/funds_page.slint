import { EmptyState, FormattedInput, BizTraceTheme, RtlButton, RtlHeading, RtlLineEdit, RtlTabs, RtlText } from "../components/mod.slint";
import { ScrollView } from "std-widgets.slint";
import { FundAccountData, FundAccountRow, FundTransactionData, FundTransactionRow, FundCheckData, FundCheckRow } from "fund_rows.slint";
import { FundAccountEditor, FundTransactionEditor, FundCheckEditor } from "fund_editors.slint";

export component FundsPage inherits Rectangle {
 in property<bool> narrow; in property<[FundAccountData]> accounts; in property<[FundTransactionData]> transactions; in property<[FundCheckData]> checks; in property<[string]> account-names;
 in-out property<string> search-text; in-out property<bool> account-editor-open; in-out property<bool> transaction-editor-open; in-out property<bool> check-editor-open; in property<string> editor-error;
 callback search(string); callback format-amount(string,int)->FormattedInput; callback save-account(string,string,string,int,string); callback remove-account(string); callback save-transaction(int,int,int,string,string,string,string,string); callback remove-transaction(string); callback save-check(int,int,string,string,string,string,string,string); callback check-status(string,int);
 background:transparent; property<int> current-tab:0; property<bool> compact:root.narrow||root.width<700px;
 ScrollView{width:parent.width;height:parent.height;VerticalLayout{padding:root.compact?14px:28px;spacing:14px;alignment:start;
  RtlHeading{text:"وجوه و حساب‌ها";}RtlText{text:"مدیریت حساب‌ها، گردش‌های مالی و چک‌های سررسیددار";color:BizTraceTheme.text-muted;}
  RtlTabs{tabs:["حساب‌ها","تراکنش‌ها","چک‌ها"];current-index<=>root.current-tab;}
  HorizontalLayout{height:40px;spacing:8px;Rectangle{horizontal-stretch:1;}if root.current-tab>0:RtlLineEdit{horizontal-stretch:1;text<=>root.search-text;placeholder-text:root.current-tab==1?"جستجو با حساب، دسته‌بندی یا شناسه":"جستجو با طرف حساب، شماره چک یا بانک";edited(v)=>{root.search(v);}}RtlButton{width:root.compact?135px:175px;text:root.current-tab==0?"حساب جدید":root.current-tab==1?"تراکنش جدید":"چک جدید";icon:root.current-tab==0?@image-url("../../assets/icons/wallet-cards.svg"):root.current-tab==1?@image-url("../../assets/icons/receipt-text.svg"):@image-url("../../assets/icons/notebook-pen.svg");clicked=>{if root.current-tab==0{account-editor.item-id="";account-editor.item-name="";account-editor.account-number="";account-editor.opening-balance="0";account-editor.kind-index=1;root.account-editor-open=true;}else if root.current-tab==1{transaction-editor.kind-index=0;transaction-editor.account-index=0;transaction-editor.target-index=0;transaction-editor.amount="";transaction-editor.category="";transaction-editor.occurred-on="";transaction-editor.reference="";transaction-editor.description="";root.transaction-editor-open=true;}else{check-editor.direction-index=0;check-editor.account-index=0;check-editor.party-name="";check-editor.check-number="";check-editor.bank-name="";check-editor.amount="";check-editor.due-on="";check-editor.note="";root.check-editor-open=true;}}}
  }
  if root.current-tab==0&&root.accounts.length==0:EmptyState{icon:@image-url("../../assets/icons/wallet-cards.svg");title:"حساب مالی وجود ندارد";description:"صندوق، حساب بانکی یا کارت خود را تعریف کنید.";action-text:"افزودن حساب";action=>{root.account-editor-open=true;}}
  for item in root.accounts:FundAccountRow{visible:root.current-tab==0;item:item;edit=>{account-editor.item-id=item.id;account-editor.item-name=item.name;account-editor.account-number=item.account-number;account-editor.opening-balance=item.opening-value;account-editor.kind-index=item.kind-label=="صندوق نقدی"?0:item.kind-label=="حساب بانکی"?1:item.kind-label=="کارت"?2:3;root.account-editor-open=true;}remove=>{root.remove-account(item.id);}}
  if root.current-tab==1&&root.transactions.length==0:EmptyState{icon:@image-url("../../assets/icons/receipt-text.svg");title:"تراکنشی ثبت نشده";description:"درآمد، هزینه یا انتقال بین حساب‌ها را ثبت کنید.";action-text:"ثبت تراکنش";action=>{root.transaction-editor-open=true;}}
  for item in root.transactions:FundTransactionRow{visible:root.current-tab==1;item:item;remove=>{root.remove-transaction(item.id);}}
  if root.current-tab==2&&root.checks.length==0:EmptyState{icon:@image-url("../../assets/icons/notebook-pen.svg");title:"چکی ثبت نشده";description:"چک‌های دریافتی و پرداختی آینده را پیگیری کنید.";action-text:"ثبت چک";action=>{root.check-editor-open=true;}}
  for item in root.checks:FundCheckRow{visible:root.current-tab==2;item:item;status(value)=>{root.check-status(item.id,value);}}
 }}
 account-editor:=FundAccountEditor{width:parent.width;height:parent.height;open<=>root.account-editor-open;error-message:root.editor-error;format(v,c)=>{return root.format-amount(v,c);}save(id,name,number,kind,balance)=>{root.save-account(id,name,number,kind,balance);}}
 transaction-editor:=FundTransactionEditor{width:parent.width;height:parent.height;open<=>root.transaction-editor-open;accounts:root.account-names;error-message:root.editor-error;format(v,c)=>{return root.format-amount(v,c);}save(kind,account,target,amount,category,date,reference,description)=>{root.save-transaction(kind,account,target,amount,category,date,reference,description);}}
 check-editor:=FundCheckEditor{width:parent.width;height:parent.height;open<=>root.check-editor-open;accounts:root.account-names;error-message:root.editor-error;format(v,c)=>{return root.format-amount(v,c);}save(direction,account,party,number,bank,amount,due,note)=>{root.save-check(direction,account,party,number,bank,amount,due,note);}}
}
