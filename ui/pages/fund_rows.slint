import { IconButton, BizTraceTheme, RtlText } from "../components/mod.slint";

export struct FundAccountData { id:string, name:string, kind-label:string, account-number:string, opening-value:string, balance-label:string }
export struct FundTransactionData { id:string, kind-label:string, account-label:string, amount-label:string, category:string, occurred-on:string, reference:string }
export struct FundCheckData { id:string, direction-label:string, party-name:string, account-name:string, check-number:string, bank-name:string, amount-label:string, due-on:string, status-code:string, status-label:string }

export component FundAccountRow inherits Rectangle {
 in property <FundAccountData> item; callback edit; callback remove; height:64px; background:transparent;
 Rectangle { width:parent.width; height:parent.height; background:BizTraceTheme.surface; border-color:BizTraceTheme.border; border-width:1px; border-radius:8px;
  HorizontalLayout { padding-left:10px; padding-right:14px; spacing:10px; cross-axis-alignment:center;
   IconButton { icon:@image-url("../../assets/icons/trash-2.svg"); label:"حذف"; danger:true; clicked=>{root.remove();} }
   IconButton { icon:@image-url("../../assets/icons/pencil.svg"); label:"ویرایش"; clicked=>{root.edit();} }
   RtlText { width:150px; text:root.item.balance-label; font-weight:700; }
   VerticalLayout { horizontal-stretch:1; spacing:1px; RtlText{text:root.item.name;font-weight:600;} RtlText{text:root.item.account-number.is-empty?root.item.kind-label:root.item.kind-label+" • "+root.item.account-number;color:BizTraceTheme.text-faint;font-size:12px;} }
  }
 }
}
export component FundTransactionRow inherits Rectangle {
 in property <FundTransactionData> item; callback remove; height:64px; background:transparent;
 Rectangle { width:parent.width; height:parent.height; background:BizTraceTheme.surface; border-color:BizTraceTheme.border; border-width:1px; border-radius:8px;
  HorizontalLayout { padding-left:10px; padding-right:14px; spacing:10px; cross-axis-alignment:center;
   IconButton { icon:@image-url("../../assets/icons/trash-2.svg"); label:"حذف"; danger:true; clicked=>{root.remove();} }
   RtlText { width:120px; text:root.item.occurred-on; color:BizTraceTheme.text-muted; }
   RtlText { width:150px; text:root.item.amount-label; font-weight:700; color:root.item.kind-label=="هزینه"?#ff9aaa:#7fd9a4; }
   VerticalLayout { horizontal-stretch:1; spacing:1px; RtlText{text:root.item.category+" • "+root.item.account-label;font-weight:600;} RtlText{text:root.item.reference.is-empty?root.item.kind-label:root.item.kind-label+" • "+root.item.reference;color:BizTraceTheme.text-faint;font-size:12px;} }
  }
 }
}
export component FundCheckRow inherits Rectangle {
 in property <FundCheckData> item; callback status(int); height:68px; background:transparent;
 Rectangle { width:parent.width; height:parent.height; background:BizTraceTheme.surface; border-color:BizTraceTheme.border; border-width:1px; border-radius:8px;
  HorizontalLayout { padding-left:10px; padding-right:14px; spacing:8px; cross-axis-alignment:center;
   if root.item.status-code=="upcoming": IconButton { icon:@image-url("../../assets/icons/check.svg"); label:"وصول/پرداخت شد"; clicked=>{root.status(1);} }
   if root.item.status-code=="upcoming": IconButton { icon:@image-url("../../assets/icons/rotate-ccw.svg"); label:"برگشتی"; clicked=>{root.status(2);} }
   if root.item.status-code=="upcoming": IconButton { icon:@image-url("../../assets/icons/x.svg"); label:"لغو"; clicked=>{root.status(3);} }
   RtlText { width:105px; text:root.item.due-on; color:BizTraceTheme.text-muted; }
   RtlText { width:145px; text:root.item.amount-label; font-weight:700; color:root.item.direction-label=="دریافتی"?#7fd9a4:#ff9aaa; }
   VerticalLayout { horizontal-stretch:1; spacing:1px; RtlText{text:root.item.party-name+" • "+root.item.check-number;font-weight:600;} RtlText{text:root.item.direction-label+" • "+root.item.status-label+" • "+root.item.account-name;color:BizTraceTheme.text-faint;font-size:12px;} }
  }
 }
}
