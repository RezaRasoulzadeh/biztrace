// ui/pages/settings_page.slint

import { BizTraceTheme, RtlCard, RtlHeading, RtlText } from "../components/mod.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsPage inherits Rectangle {
    in property <bool> narrow;
    background: transparent;

    ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            padding: root.narrow ? 14px : 28px;
            spacing: 18px;
            RtlHeading { text: "تنظیمات"; }
            RtlText { text: "پیکربندی عمومی برنامه و کسب‌وکار"; color: BizTraceTheme.text-muted; }
            RtlCard {
                height: 132px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    RtlText { text: "پایگاه داده"; font-size: 17px; font-weight: 600; }
                    RtlText { text: "ساختار پایگاه داده آماده است و مهاجرت‌ها هنگام اجرای برنامه مدیریت می‌شوند."; color: BizTraceTheme.text-muted; }
                }
            }
        }
    }
}
