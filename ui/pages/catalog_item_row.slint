// ui/pages/catalog_item_row.slint

import { IconButton, NexoraTheme, RtlText, SelectBox } from "../components/mod.slint";

export struct CatalogItemData {
    id: string,
    name: string,
    sku: string,
    kind-code: string,
    kind-label: string,
    unit-code: string,
    unit-label: string,
    price-label: string,
    price-value: string,
    selected: bool,
}

export component CatalogItemRow inherits Rectangle {
    in property <CatalogItemData> item;
    in property <bool> narrow;
    callback edit;
    callback remove;
    callback selection-changed(bool);
    height: 64px;
    background: transparent;

    card := Rectangle {
        width: root.width - 72px;
        height: parent.height;
        clip: true;
        background: row-touch.has-hover ? NexoraTheme.surface-raised : NexoraTheme.surface;
        border-color: NexoraTheme.border;
        border-width: 1px;
        border-radius: 8px;
        animate background { duration: 120ms; }
        row-touch := TouchArea { mouse-cursor: pointer; }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 14px;
            spacing: 10px;
            cross-axis-alignment: center;

            IconButton { icon: @image-url("../../assets/icons/trash-2.svg"); label: "حذف"; danger: true; clicked => { root.remove(); } }
            IconButton { icon: @image-url("../../assets/icons/pencil.svg"); label: "ویرایش"; clicked => { root.edit(); } }

            if !root.narrow : RtlText {
            width: 130px;
            text: root.item.price-label;
            wrap: no-wrap;
            overflow: elide;
        }

            if !root.narrow : RtlText {
            width: 90px;
            text: root.item.unit-label;
            color: NexoraTheme.text-muted;
            wrap: no-wrap;
            overflow: elide;
        }

            VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;

            RtlText { text: root.item.name; font-weight: 600; wrap: no-wrap; overflow: elide; }
            RtlText {
                text: root.item.sku.is-empty ? root.item.kind-label : root.item.kind-label + "  •  " + root.item.sku;
                color: NexoraTheme.text-faint;
                font-size: 12px;
                wrap: no-wrap;
                overflow: elide;
            }
            }
        }
    }
    SelectBox { x: root.width - self.width - 8px; y: (parent.height - self.height) / 2; checked: root.item.selected; toggled(value) => { root.selection-changed(value); } }
}
