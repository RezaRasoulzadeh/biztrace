// ui/pages/inventory_movement_row.slint

import { BizTraceTheme, RtlText } from "../components/mod.slint";

export struct MovementItemData {
    item-name: string,
    warehouse-name: string,
    quantity-label: string,
    increases-stock: bool,
    reference: string,
    occurred-on: string,
    unit-cost-label: string,
    total-cost-label: string,
}

export component InventoryMovementRow inherits Rectangle {
    in property <MovementItemData> item;
    in property <bool> narrow;
    height: 62px;
    background: BizTraceTheme.surface;
    border-color: BizTraceTheme.border;
    border-width: 1px;
    border-radius: 8px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        cross-axis-alignment: center;
        RtlText { width: 100px; text: (root.item.increases-stock ? "+ " : "− ") + root.item.quantity-label; color: root.item.increases-stock ? #69c58c : #e4868c; font-weight: 700; }
        if !root.narrow : RtlText { width: 130px; text: root.item.total-cost-label; color: BizTraceTheme.text-muted; wrap: no-wrap; overflow: elide; }
        if !root.narrow : RtlText { width: 120px; text: root.item.occurred-on; color: BizTraceTheme.text-muted; wrap: no-wrap; overflow: elide; }
        if !root.narrow : RtlText { width: 140px; text: root.item.warehouse-name; color: BizTraceTheme.text-muted; wrap: no-wrap; overflow: elide; }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            RtlText { text: root.item.item-name; font-weight: 600; wrap: no-wrap; overflow: elide; }
            RtlText { text: root.item.reference.is-empty ? "بدون یادداشت" : root.item.reference; color: BizTraceTheme.text-faint; font-size: 12px; wrap: no-wrap; overflow: elide; }
        }
    }
}
