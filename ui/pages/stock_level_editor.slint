// ui/pages/stock_level_editor.slint

import { FormattedInput, IconButton, NexoraTheme, RtlButton, RtlCard, RtlHeading, RtlSelectField, RtlText, RtlTextField } from "../components/mod.slint";
import { ScrollView } from "std-widgets.slint";

export component StockLevelEditor inherits Rectangle {
    in-out property <bool> open;
    in-out property <string> layer-id;
    in-out property <string> item-name;
    in-out property <string> warehouse-name;
    in property <[string]> warehouses;
    in-out property <int> warehouse-index;
    in-out property <string> current-quantity;
    in-out property <string> new-quantity;
    in-out property <string> unit-cost;
    in-out property <string> reference;
    in property <string> error-message;
    callback format-price(string, int) -> FormattedInput;
    callback save(string, int, string, string, string);
    background: #99000000;
    opacity: root.open ? 1 : 0;
    visible: root.opacity > 0;
    animate opacity { duration: 150ms; }
    FocusScope { width: parent.width; height: parent.height; focus-on-click: true; focus-on-tab-navigation: false; }
    RtlCard {
        x: (parent.width - self.width) / 2;
        y: root.open ? (parent.height - self.height) / 2 : (parent.height - self.height) / 2 + 18px;
        width: min(560px, parent.width - 28px);
        height: min(520px, parent.height - 28px);
        animate y { duration: 180ms; easing: ease-out; }
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            HorizontalLayout { height: 38px; IconButton { icon: @image-url("../../assets/icons/x.svg"); label: "بستن"; clicked => { root.open = false; } } RtlHeading { horizontal-stretch: 1; text: "ویرایش ردیف موجودی"; font-size: 20px; } }
            Rectangle {
                vertical-stretch: 1;
                clip: true;
                ScrollView {
                    width: parent.width - 8px;
                    height: parent.height;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalLayout {
                        padding-right: 22px;
                        spacing: 13px;
                        RtlText { height: 28px; text: root.item-name + "  •  " + root.warehouse-name; font-weight: 600; }
                        RtlText { height: 26px; text: "مقدار فعلی این ردیف: " + root.current-quantity; color: NexoraTheme.text-muted; }
                        RtlSelectField { label: "انبار:"; model: root.warehouses; current-index <=> root.warehouse-index; }
                        RtlTextField { label: "مقدار جدید:"; text <=> root.new-quantity; placeholder-text: "مقدار نهایی این ردیف"; }
                        RtlTextField { label: "بهای خرید هر واحد:"; text <=> root.unit-cost; placeholder-text: "ریال"; numeric-mode: true; format-numeric(value, cursor) => { return root.format-price(value, cursor); } }
                        RtlTextField { label: "دلیل ویرایش:"; text <=> root.reference; placeholder-text: "مثلاً اصلاح فاکتور خرید"; }
                        if !root.error-message.is-empty : RtlText { height: 26px; text: root.error-message; color: #ff9aaa; font-size: 12px; }
                    }
                }
            }
            RtlButton { height: 40px; text: "ذخیره تغییرات"; icon: @image-url("../../assets/icons/check.svg"); clicked => { root.save(root.layer-id, root.warehouse-index, root.new-quantity, root.unit-cost, root.reference); } }
        }
    }
}
