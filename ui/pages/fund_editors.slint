import { FormattedInput, IconButton, PersianDatePicker, BizTraceTheme, RtlButton, RtlCard, RtlHeading, RtlSelectField, RtlText, RtlTextField } from "../components/mod.slint";
import { ScrollView } from "std-widgets.slint";

export component FundAccountEditor inherits Rectangle {
 in-out property<bool> open; in-out property<string> item-id; in-out property<string> item-name; in-out property<string> account-number; in-out property<string> opening-balance; in-out property<int> kind-index; in property<string> error-message; callback format(string,int)->FormattedInput; callback save(string,string,string,int,string); background:#99000000; visible:open;
 card:=RtlCard{x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:min(560px,parent.width - 28px);height:min(520px,parent.height - 28px);
  header:=HorizontalLayout{x:22px;y:18px;width:parent.width - 44px;height:40px;IconButton{icon:@image-url("../../assets/icons/x.svg");label:"بستن";clicked=>{root.open=false;}}RtlHeading{horizontal-stretch:1;text:root.item-id.is-empty?"حساب جدید":"ویرایش حساب";font-size:20px;}}
  Rectangle{x:18px;y:68px;width:parent.width - 36px;height:parent.height - 136px;clip:true;ScrollView{width:parent.width;height:parent.height;VerticalLayout{padding-right:10px;spacing:13px;RtlSelectField{label:"نوع حساب:";model:["صندوق نقدی","حساب بانکی","کارت","سایر"];current-index<=>root.kind-index;}RtlTextField{label:"نام حساب:";text<=>root.item-name;placeholder-text:root.kind-index==0?"مثلاً صندوق فروشگاه":root.kind-index==1?"مثلاً حساب بانک ملت":root.kind-index==2?"مثلاً کارت جاری":"نام حساب";}if root.kind-index!=0:RtlTextField{label:root.kind-index==1?"شماره حساب/شبا:":root.kind-index==2?"شماره کارت:":"شناسه حساب:";text<=>root.account-number;placeholder-text:root.kind-index==1?"شماره حساب یا شبا":root.kind-index==2?"۱۶ رقم":"اختیاری";}RtlTextField{label:"موجودی افتتاحیه:";text<=>root.opening-balance;numeric-mode:true;format-numeric(v,c)=>{return root.format(v,c);}}if !root.error-message.is-empty:RtlText{text:root.error-message;color:#ff9aaa;}}}}
  footer:=Rectangle{x:18px;y:parent.height - 58px;width:parent.width - 36px;height:40px;background:BizTraceTheme.surface;RtlButton{width:parent.width;height:parent.height;text:"ذخیره حساب";clicked=>{root.save(root.item-id,root.item-name,root.kind-index==0?"":root.account-number,root.kind-index,root.opening-balance);}}}
 }
}
export component FundTransactionEditor inherits Rectangle {
 in-out property<bool> open; in-out property<string> item-id; in property<[string]> accounts; in-out property<int> account-index; in-out property<int> target-index; in-out property<int> kind-index; in-out property<string> amount; in-out property<string> category; in-out property<string> occurred-on; in-out property<string> reference; in-out property<string> description; in property<string> error-message; callback format(string,int)->FormattedInput; callback to-gregorian(int,int,int)->string; callback today-date()->string; pure callback jalali-component(string,int)->int; pure callback calendar-day(int,int,int)->int; callback save(string,int,int,int,string,string,string,string,string); background:#99000000;visible:open;
 card:=RtlCard{x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:min(600px,parent.width - 28px);height:min(620px,parent.height - 28px);
  HorizontalLayout{x:22px;y:18px;width:parent.width - 44px;height:40px;IconButton{icon:@image-url("../../assets/icons/x.svg");label:"بستن";clicked=>{root.open=false;}}RtlHeading{horizontal-stretch:1;text:root.item-id.is-empty?"ثبت تراکنش":"ویرایش تراکنش";font-size:20px;}}
  Rectangle{x:18px;y:68px;width:parent.width - 36px;height:parent.height - 136px;clip:true;ScrollView{width:parent.width;height:parent.height;VerticalLayout{padding-right:10px;spacing:12px;PersianDatePicker{label:"تاریخ:";value<=>root.occurred-on;to-gregorian(y,m,d)=>{return root.to-gregorian(y,m,d);}calendar-day(y,m,c)=>{return root.calendar-day(y,m,c);}}RtlSelectField{label:"نوع:";model:["درآمد","هزینه","انتقال بین حساب‌ها"];current-index<=>root.kind-index;}RtlSelectField{label:root.kind-index==2?"از حساب:":"حساب:";model:root.accounts;current-index<=>root.account-index;}if root.kind-index==2:RtlSelectField{label:"به حساب:";model:root.accounts;current-index<=>root.target-index;}RtlTextField{label:"مبلغ:";text<=>root.amount;numeric-mode:true;format-numeric(v,c)=>{return root.format(v,c);}}RtlTextField{label:"دسته‌بندی:";text<=>root.category;placeholder-text:"مثلاً فروش، اجاره، خرید";}RtlTextField{label:"شماره/شناسه پیگیری:";text<=>root.reference;placeholder-text:"اختیاری و یکتا";}RtlTextField{label:"شرح:";text<=>root.description;placeholder-text:"اختیاری";}if !root.error-message.is-empty:RtlText{text:root.error-message;color:#ff9aaa;}}}}
  Rectangle{x:18px;y:parent.height - 58px;width:parent.width - 36px;height:40px;background:BizTraceTheme.surface;RtlButton{width:parent.width;height:parent.height;text:root.item-id.is-empty?"ثبت تراکنش":"ویرایش تراکنش";clicked=>{root.save(root.item-id,root.kind-index,root.account-index,root.target-index,root.amount,root.category,root.occurred-on,root.reference,root.description);}}}
 }
}
export component FundCheckEditor inherits Rectangle {
 in-out property<bool> open; in-out property<string> item-id; in property<[string]> accounts; in-out property<int> account-index; in-out property<int> direction-index; in-out property<string> party-name; in-out property<string> check-number; in-out property<string> bank-name; in-out property<string> amount; in-out property<string> due-on; in-out property<string> note; in property<string> error-message; callback format(string,int)->FormattedInput; callback to-gregorian(int,int,int)->string; callback today-date()->string; pure callback jalali-component(string,int)->int; pure callback calendar-day(int,int,int)->int; callback save(string,int,int,string,string,string,string,string,string); background:#99000000;visible:open;
 card:=RtlCard{x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:min(600px,parent.width - 28px);height:min(620px,parent.height - 28px);
  HorizontalLayout{x:22px;y:18px;width:parent.width - 44px;height:40px;IconButton{icon:@image-url("../../assets/icons/x.svg");label:"بستن";clicked=>{root.open=false;}}RtlHeading{horizontal-stretch:1;text:root.item-id.is-empty?"ثبت چک":"ویرایش چک";font-size:20px;}}
  Rectangle{x:18px;y:68px;width:parent.width - 36px;height:parent.height - 136px;clip:true;ScrollView{width:parent.width;height:parent.height;VerticalLayout{padding-right:10px;spacing:12px;PersianDatePicker{label:"تاریخ سررسید:";value<=>root.due-on;to-gregorian(y,m,d)=>{return root.to-gregorian(y,m,d);}calendar-day(y,m,c)=>{return root.calendar-day(y,m,c);}}RtlSelectField{label:"جهت:";model:["دریافتی","پرداختی"];current-index<=>root.direction-index;}RtlSelectField{label:root.direction-index==0?"حساب مقصد:":"حساب صادرکننده:";model:root.accounts;current-index<=>root.account-index;}RtlTextField{label:root.direction-index==0?"صادرکننده چک:":"دریافت‌کننده چک:";text<=>root.party-name;}RtlTextField{label:"شماره چک:";text<=>root.check-number;}if root.direction-index==0:RtlTextField{label:"بانک صادرکننده:";text<=>root.bank-name;placeholder-text:"نام بانک روی چک";}RtlTextField{label:"مبلغ:";text<=>root.amount;numeric-mode:true;format-numeric(v,c)=>{return root.format(v,c);}}RtlTextField{label:"یادداشت:";text<=>root.note;placeholder-text:"اختیاری";}if !root.error-message.is-empty:RtlText{text:root.error-message;color:#ff9aaa;}}}}
  Rectangle{x:18px;y:parent.height - 58px;width:parent.width - 36px;height:40px;background:BizTraceTheme.surface;RtlButton{width:parent.width;height:parent.height;text:root.item-id.is-empty?"ثبت چک":"ویرایش چک";clicked=>{root.save(root.item-id,root.direction-index,root.account-index,root.party-name,root.check-number,root.direction-index==0?root.bank-name:"",root.amount,root.due-on,root.note);}}}
 }
}
